rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateId) {
      return dateId is string && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDailyRecord(data, userId, dateId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.date is string && data.date == dateId && isValidDateId(data.date) &&
        data.purchasePcs is int && data.purchasePcs >= 0 && data.purchasePcs <= 1000000 &&
        data.purchaseWeightKg is number && data.purchaseWeightKg >= 0 && data.purchaseWeightKg <= 10000000 &&
        data.purchaseRatePerKg is number && data.purchaseRatePerKg >= 0 && data.purchaseRatePerKg <= 1000000 &&
        data.actualClosingPcs is int && data.actualClosingPcs >= 0 && data.actualClosingPcs <= 1000000 &&
        data.actualClosingWeightKg is number && data.actualClosingWeightKg >= 0 && data.actualClosingWeightKg <= 10000000 &&
        (!('remainingStockValue' in data) || (data.remainingStockValue is number && data.remainingStockValue >= 0 && data.remainingStockValue <= 1000000000)) &&
        data.shopExpenses is number && data.shopExpenses >= 0 && data.shopExpenses <= 100000000 &&
        data.workerPayment is number && data.workerPayment >= 0 && data.workerPayment <= 100000000 &&
        data.otherExpenses is number && data.otherExpenses >= 0 && data.otherExpenses <= 100000000 &&
        data.customerCount is int && data.customerCount >= 0 && data.customerCount <= 100000 &&
        data.totalSoldPcs is int && data.totalSoldPcs >= 0 && data.totalSoldPcs <= 1000000 &&
        data.totalSoldWeightKg is number && data.totalSoldWeightKg >= 0 && data.totalSoldWeightKg <= 10000000 &&
        data.totalSalesAmount is number && data.totalSalesAmount >= 0 && data.totalSalesAmount <= 1000000000 &&
        data.totalDepositAmount is number && data.totalDepositAmount >= 0 && data.totalDepositAmount <= 1000000000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomerSale(data, userId, dateId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.recordDate is string && data.recordDate == dateId && isValidDateId(data.recordDate) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.pcs is int && data.pcs >= 0 && data.pcs <= 1000000 &&
        data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 1000000 &&
        data.ratePerKg is number && data.ratePerKg >= 0 && data.ratePerKg <= 1000000 &&
        data.depositAmount is number && data.depositAmount >= 0 && data.depositAmount <= 100000000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/dailyRecords/{dateId} {
      allow get: if isOwner(userId) && isValidDateId(dateId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidDateId(dateId) &&
        incoming().keys().hasAll([
          'userId', 'date', 'purchasePcs', 'purchaseWeightKg', 'purchaseRatePerKg',
          'actualClosingPcs', 'actualClosingWeightKg',
          'shopExpenses', 'workerPayment', 'otherExpenses',
          'customerCount', 'totalSoldPcs', 'totalSoldWeightKg', 'totalSalesAmount', 'totalDepositAmount',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'date', 'purchasePcs', 'purchaseWeightKg', 'purchaseRatePerKg',
          'actualClosingPcs', 'actualClosingWeightKg', 'remainingStockValue',
          'shopExpenses', 'workerPayment', 'otherExpenses',
          'customerCount', 'totalSoldPcs', 'totalSoldWeightKg', 'totalSalesAmount', 'totalDepositAmount',
          'createdAt', 'updatedAt'
        ]) &&
        isValidDailyRecord(incoming(), userId, dateId);

      allow update: if isOwner(userId) &&
        isValidDateId(dateId) &&
        isValidDailyRecord(incoming(), userId, dateId) &&
        incoming().userId == existing().userId &&
        incoming().date == existing().date &&
        incoming().createdAt == existing().createdAt &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'purchasePcs', 'purchaseWeightKg', 'purchaseRatePerKg',
            'actualClosingPcs', 'actualClosingWeightKg', 'remainingStockValue',
            'shopExpenses', 'workerPayment', 'otherExpenses',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'customerCount', 'totalSoldPcs', 'totalSoldWeightKg',
            'totalSalesAmount', 'totalDepositAmount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'purchasePcs', 'purchaseWeightKg', 'purchaseRatePerKg',
            'actualClosingPcs', 'actualClosingWeightKg', 'remainingStockValue',
            'shopExpenses', 'workerPayment', 'otherExpenses',
            'customerCount', 'totalSoldPcs', 'totalSoldWeightKg',
            'totalSalesAmount', 'totalDepositAmount', 'updatedAt'
          ])
        );

      allow delete: if isOwner(userId) && isValidDateId(dateId);

      match /customerSales/{saleId} {
        allow get: if isOwner(userId) && isValidDateId(dateId) && isValidId(saleId);
        allow list: if isOwner(userId) && isValidDateId(dateId);

        allow create: if isOwner(userId) &&
          isValidDateId(dateId) &&
          isValidId(saleId) &&
          incoming().keys().hasAll([
            'userId', 'recordDate', 'customerName', 'pcs', 'weightKg',
            'ratePerKg', 'depositAmount', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'recordDate', 'customerName', 'pcs', 'weightKg',
            'ratePerKg', 'depositAmount', 'createdAt', 'updatedAt'
          ]) &&
          isValidCustomerSale(incoming(), userId, dateId);

        allow update: if isOwner(userId) &&
          isValidDateId(dateId) &&
          isValidId(saleId) &&
          isValidCustomerSale(incoming(), userId, dateId) &&
          incoming().userId == existing().userId &&
          incoming().recordDate == existing().recordDate &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'customerName', 'pcs', 'weightKg', 'ratePerKg', 'depositAmount', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidDateId(dateId) && isValidId(saleId);
      }
    }
  }
}
